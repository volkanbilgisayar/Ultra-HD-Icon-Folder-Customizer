{
  "manifest_version": 3,
  "name": "Resmi ICO Olarak Kaydet (Saf 256 HD)",
  "version": "1.3",
  "description": "Google Görseller dahil web'deki resimleri saf 256x256 Ultra HD kalitede ICO olarak indirir.",
  "permissions": [
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
